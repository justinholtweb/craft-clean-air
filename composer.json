{
    "name": "justinholtweb/craft-cleanair",
    "description": "Advanced control panel filtering for every element type — build multi-criteria filters, save and share them, and export the results.",
    "type": "craft-plugin",
    "version": "5.0.0",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "cleanair",
        "filter",
        "filters",
        "control panel",
        "export",
        "csv",
        "cpfilters"
    ],
    "license": "proprietary",
    "homepage": "https://justinholt.com/plugins/craft-cleanair",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://justinholt.com"
        }
    ],
    "support": {
        "email": "justin@justinholt.com",
        "docs": "https://justinholt.com/plugins/craft-cleanair/docs",
        "source": "https://github.com/justinholtweb/craft-cleanair",
        "issues": "https://github.com/justinholtweb/craft-cleanair/issues"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "craftcms/cms": "^5.3.0"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "justinholtweb\\cleanair\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "justinholtweb\\cleanair\\tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true,
            "craftcms/generator": true
        }
    },
    "extra": {
        "name": "Clean Air",
        "handle": "cleanair",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://justinholt.com/plugins/craft-cleanair/docs",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-cleanair/main/CHANGELOG.md",
        "class": "justinholtweb\\cleanair\\Plugin"
    }
}
